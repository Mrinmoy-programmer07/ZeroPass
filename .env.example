# Local testnet secrets only. Never commit .env or paste secrets into chat.
MIDNIGHT_NETWORK=preprod
PROOF_SERVER_URL=http://127.0.0.1:6300
# 32-byte hexadecimal SDK seed, not a mnemonic phrase.
WALLET_SEED=
# A separate random 32-byte hexadecimal secret used by register_issuer.
ADMIN_SECRET=
# At least 16 characters; uppercase, lowercase, numbers and symbols recommended.
PRIVATE_STATE_PASSWORD=
