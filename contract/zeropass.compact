pragma language_version 0.26;

import CompactStandardLibrary;

// ZeroPass - Anonymous Credential Verification

// Public credential status stored on-chain
// We keep it flat — just booleans, to avoid ADT subscript issues
ledger credential_exists:  Map<Bytes<32>, Boolean>;
ledger credential_revoked: Map<Bytes<32>, Boolean>;
ledger credential_type:    Map<Bytes<32>, Bytes<32>>;
ledger credential_issuer:  Map<Bytes<32>, Bytes<32>>;

// Authorized issuers and admin
ledger issuer_registry: Map<Bytes<32>, Boolean>;
ledger admin: Bytes<32>;

// Counters
ledger total_issued:   Counter;
ledger total_verified: Counter;

// Witness: nullifier-spent set
ledger used_nullifiers: Map<Bytes<32>, Boolean>;

// Witnesses (Private — Off-Chain)
witness get_secret():          Bytes<32>;   // user's private secret
witness get_salt():            Bytes<32>;   // random salt used at issuance
witness get_credential_type(): Bytes<32>;   // e.g. "KYC_VERIFIED"
witness get_admin_secret():    Bytes<32>;
witness get_issuer_secret():   Bytes<32>;

struct CommitInput {
  secret: Bytes<32>;
  salt:   Bytes<32>;
  ctype:  Bytes<32>;
}

struct NullifierInput {
  secret:        Bytes<32>;
  label:         Bytes<32>;
  expected_type: Bytes<32>;
}

// Initialize the contract — admin_id = persistentHash<Bytes<32>>(admin_secret)
constructor(admin_id: Bytes<32>) {
  admin = disclose(admin_id);
  return [];
}

// Admin registers a trusted issuer
export circuit register_issuer(issuer_id: Bytes<32>): [] {
  const secret       = get_admin_secret();
  const derived      = persistentHash<Bytes<32>>(secret);
  assert(derived == admin, "Not admin");

  issuer_registry.insert(issuer_id, true);
  return [];
}

// Issuer issues a credential commitment
export circuit issue_credential(
  commitment:      Bytes<32>,
  cred_type:       Bytes<32>
): [] {
  const secret    = get_issuer_secret();
  const issuer_id = persistentHash<Bytes<32>>(secret);
  assert(issuer_registry.member(issuer_id), "Unauthorized issuer");

  credential_exists.insert(commitment, true);
  credential_revoked.insert(commitment, false);
  credential_type.insert(commitment, disclose(cred_type));
  credential_issuer.insert(commitment, disclose(issuer_id));

  total_issued.increment(1);
  return [];
}

// User proves they hold a valid credential without revealing it
export circuit verify_credential(expected_type: Bytes<32>): [] {
  const secret = get_secret();
  const salt   = get_salt();
  const ctype  = get_credential_type();

  // Recompute commitment from private inputs
  const commitment = persistentHash<CommitInput>(CommitInput {
    secret: secret,
    salt:   salt,
    ctype:  ctype
  });

  // Credential must exist
  assert(credential_exists.member(commitment), "Credential not registered");

  // Type must match
  assert(ctype == expected_type, "Wrong credential type");

  // Credential must not be revoked
  assert(!credential_revoked.member(commitment), "Credential revoked");

  // Nullifier check — prevent double-use
  const nullify_label = pad(32, "nullify");
  const nullifier = persistentHash<NullifierInput>(NullifierInput {
    secret:        secret,
    label:         nullify_label,
    expected_type: expected_type
  });
  assert(!used_nullifiers.member(nullifier), "Credential already used");

  used_nullifiers.insert(nullifier, disclose(true));
  total_verified.increment(1);
  return [];
}

// Issuer revokes a credential
export circuit revoke_credential(commitment: Bytes<32>): [] {
  const secret    = get_issuer_secret();
  const issuer_id = persistentHash<Bytes<32>>(secret);
  assert(issuer_registry.member(issuer_id), "Unauthorized");
  assert(credential_exists.member(commitment), "Credential not found");

  credential_revoked.insert(commitment, true);
  return [];
}
